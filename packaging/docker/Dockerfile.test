FROM rust:1-slim-bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev cmake build-essential
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN RUSTFLAGS="-g" cargo build --release --package vuio-cli --bin vuio

FROM debian:12-slim
RUN apt-get update && apt-get install -y ca-certificates procps curl python3 htop && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/vuio /app/vuio
RUN chmod +x /app/vuio
RUN mkdir -p /media /data /config
EXPOSE 8080 8090
CMD ["/app/vuio", "--config", "/config/config.toml"]
